# WhatsApp Claude Bridge Configuration

# Server
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# WhatsApp API Connection
WHATSAPP_API_URL=http://localhost:3000
WHATSAPP_API_KEY=your-whatsapp-api-key

# OpenRouter API (for summarization)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Base Path for Projects
BASE_PATH=C:\RemoteClaudeCode

# Permissions
PERMISSION_TIMEOUT=120
AUTO_APPROVE_READS=true
AUTO_APPROVE_EDITS=true

# Logging
LOG_LEVEL=info

# Admin Phone Numbers (comma separated, with country code)
ADMIN_PHONES=972501234567,972509876543
